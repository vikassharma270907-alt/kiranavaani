# Gnani AI API Credentials
# Replace with your actual Gnani API key from https://vachana.ai
# If left empty, KiranaVaani operates in clearly-labelled Mock/Demo mode.
GNANI_API_KEY=

# Gnani Speech-to-Text (Prisma v3.0)
GNANI_STT_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0

# Gnani Text-to-Speech (Timbre v2.5 / v3.0)
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false

# NLP & Matching Sensitivity Thresholds
CONFIDENCE_THRESHOLD=0.78
AMBIGUITY_DELTA_THRESHOLD=0.12
